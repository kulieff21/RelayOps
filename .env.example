# Local sandbox only. No credentials are needed for the current backend.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=runtime/relayops-demo.sqlite
DEMO_CLOCK=2026-10-12T08:00:00.000Z
# Frozen business clock keeps fictional quotes reproducible; session time is real.
# Optional server-side adapter. Never prefix credentials with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_PROVIDER=openai
OPENROUTER_MAX_OUTPUT_TOKENS=512
OPENROUTER_TIMEOUT_MS=30000
# Shared total for development and initial live smoke tests, in USD.
OPENROUTER_BUDGET_USD=1
# Evaluation remains disabled until its sample and budget are selected.
OPENROUTER_EVALUATION_BUDGET_USD=0
