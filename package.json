{
  "name": "relayops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server/main.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "dev:web": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc && vite build",
    "smoke": "npm run build && node --import tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/database.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/database.ts seed",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/database.ts reset --demo-only",
    "lint": "eslint src scripts test",
    "format": "prettier --write src scripts test docs package.json tsconfig*.json vite.config.ts index.html eslint.config.js .github",
    "format:check": "prettier --check src scripts test docs package.json tsconfig*.json vite.config.ts index.html eslint.config.js .github",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
